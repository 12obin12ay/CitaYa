<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FA"
    android:padding="24dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="32dp">

        <ImageView
            android:id="@+id/btnBackQr"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back"
            android:padding="4dp"
            app:tint="#1E1E1E"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pase de Cita"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1E1E1E"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- QR IMAGE -->
            <ImageView
                android:id="@+id/imgQr"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginBottom="24dp"
                android:scaleType="fitCenter"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Presente este código en recepción para validar su cita."
                android:textSize="12sp"
                android:textColor="#757575"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <!-- DIVIDER -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="24dp"/>

            <!-- INFO LIST -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/qrTxtPaciente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Paciente: Robinson Raymundo"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1E1E1E"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/qrTxtDoctor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Doctor: Dr. Miguel Salazar"
                    android:textSize="14sp"
                    android:textColor="#555"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/qrTxtEspecialidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Especialidad: Cardiología"
                    android:textSize="14sp"
                    android:textColor="#555"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/qrTxtFechaHora"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fecha: 25/04/2024 - 10:00 AM"
                    android:textSize="14sp"
                    android:textColor="#555"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/qrTxtEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estado: CONFIRMADA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:background="@drawable/bg_confirmada"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>